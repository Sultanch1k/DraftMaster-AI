# DraftMaster AI — API environment (copy to .env for local dev)
# All variables use the DRAFTMASTER_ prefix.

# --- Core ---
DRAFTMASTER_ENVIRONMENT=development
# Postgres in production (Render provides this as `postgres://…`; the app rewrites
# it to the psycopg driver). SQLite is used locally. Do NOT ship SQLite to
# production: Render's disk is ephemeral, so a redeploy wipes entitlements.
# A Render free Postgres expires 30 days after creation — use a paid plan.
DRAFTMASTER_DATABASE_URL=sqlite:///./draftmaster.db
# Redis in production; leave empty for the in-memory cache.
DRAFTMASTER_REDIS_URL=
# Optional OpenDota API key raises the rate limit for the match coach.
DRAFTMASTER_OPENDOTA_API_KEY=

# --- Product ---
DRAFTMASTER_FREE_DAILY_ANALYSES=3

# --- Billing (Lemon Squeezy) ---
# Signing key for premium session tokens. REQUIRED to sell anything: without it
# no premium session can be minted and the app runs free-only.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
DRAFTMASTER_SECRET_KEY=
# Store credentials used to validate license keys on activation.
DRAFTMASTER_LEMONSQUEEZY_API_KEY=
DRAFTMASTER_LEMONSQUEEZY_STORE_ID=
# Signing secret for the billing webhook (revokes premium on refund/cancel).
DRAFTMASTER_LEMONSQUEEZY_WEBHOOK_SECRET=
# Public checkout URL. When empty the UI hides the buy button.
DRAFTMASTER_LEMONSQUEEZY_CHECKOUT_URL=
# Support/contact address shown to users.
DRAFTMASTER_SUPPORT_EMAIL=

# --- CORS ---
DRAFTMASTER_CORS_ORIGINS=*
