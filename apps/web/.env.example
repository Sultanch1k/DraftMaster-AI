# DraftMaster AI — web app environment (copy to .env.local for local dev)

# URL of the FastAPI backend. The Next.js server proxies /api/* here, so the
# browser only ever talks to the web origin (no CORS, no exposed backend port).
# Local dev default: http://127.0.0.1:12001
# Production: the public backend URL, e.g. https://api.draftmaster.wiki
API_PROXY_TARGET=http://127.0.0.1:12001

# Canonical public URL of the site. Used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://www.draftmaster.wiki
